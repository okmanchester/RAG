# ===== 通用 =====
__pycache__/
*.py[cod]
.env

# ===== 数据：上游语料（只读，不入库）=====
data/raw
data/processed/

# ===== 临时产物 =====
tmp/

# ===== 新评测产物：生成后独立审核与发布 =====
# 只有 gold150_hard_v2 进入版本管理；其它 release 目录一律不入库
/data/benchmark/*
!/data/benchmark/gold150_hard_v2/

# ===== 评测运行产物：体积大、可由 release + 代码重建，不入库 =====
# 按目录名全局忽略（任意深度），新增同类产物目录无需再逐条追加
data/benchmark/**/full_runs/
data/benchmark/**/review_provenance/
data/benchmark/**/revision_history/

# ===== pilot/ 试跑目录：只入库人可读结论，运行产物不入库 =====
# 参见 AGENTS.md「入库的只有人可读的结论」。runs/items/scores/history/
# implementation_snapshot 等可由 release + 代码重建，且 manifest 未覆盖它们。
data/benchmark/**/pilot/*
!data/benchmark/**/pilot/report.json
!data/benchmark/**/pilot/point_review.jsonl
!data/benchmark/**/pilot/judge_disagreements.json

# ===== 运行残留 =====
*.tmp
.pytest_cache/
.mypy_cache/
.ruff_cache/
